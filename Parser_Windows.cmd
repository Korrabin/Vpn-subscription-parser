@echo off
title VPN Subscription Parser
setlocal
set "VPN_PARSER_DIR=%~dp0"
set "SELF_FILE=%~f0"
set "TMP_PS1=%TEMP%\vpn_parser_release.ps1"

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$lines = [IO.File]::ReadAllLines($env:SELF_FILE) | Where-Object { $_.StartsWith('B64:') } | ForEach-Object { $_.Substring(4) }; [IO.File]::WriteAllBytes($env:TMP_PS1, [Convert]::FromBase64String(($lines -join '')))"
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TMP_PS1%"
del /q "%TMP_PS1%" >nul 2>nul
echo.
pause
exit /b 0

